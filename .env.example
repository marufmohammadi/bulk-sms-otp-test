# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# BULKSMSBD_API_KEY: Required for sending OTP and Booking Confirmation SMS via BulkSMSBD (http://bulksmsbd.net/api/smsapi)
BULKSMSBD_API_KEY=""

# BULKSMSBD_SENDER_ID: Approved BulkSMSBD Sender ID (default: 8809617623984)
BULKSMSBD_SENDER_ID="8809617623984"

# BRAND_NAME: Company or Brand Name used in SMS templates
BRAND_NAME="DhakaReserve"

# ADMIN_USERNAME & ADMIN_PASSWORD: Credentials for Admin Panel access
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# Cloud SQL Runtime Environment Variables (Automatically injected by the platform)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

